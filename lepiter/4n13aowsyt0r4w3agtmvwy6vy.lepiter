				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Gt4Security is organized as a small set of HTTP client classes that return domain objects, plus a unified cross-source query object. Each source client is independent and composable — following the same shape as {{gtClass:Gt4CloudflareClient}}.\n"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "blockQuoteSnippet",
