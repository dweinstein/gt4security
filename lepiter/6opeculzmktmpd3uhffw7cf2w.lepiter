					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-04-11T22:40:53.243632-04:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "tRBvHKokTqKnyWRujYwYfw=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "## 6. Slice a result set\n\nA quick taste of the kind of moldable query you'll get for free in Phase 3 — here we just use collection operations to filter the raw Android kernel result set by severity-score presence and ecosystem."
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-04-11T22:40:53.261388-04:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-04-11T22:40:53.261388-04:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "4Ol9pqgLTyy53pkw/YTDBA=="
				},
				"code" : "| vulns withScore |\nvulns := Gt4SecurityOsvClient new queryAndroidPackage: ':linux_kernel:'.\nwithScore := vulns select: [ :v | v primarySeverityScore notEmpty ].\n{\n\t'total'               -> vulns size.\n\t'with severity score' -> withScore size.\n\t'unique ecosystems'   -> ((vulns flatCollect: #ecosystems) asSet asArray).\n\t'sample id'           -> vulns first id\n} asDictionary"
			},
			{
				"__type" : "textSnippet",
				"children" : {
