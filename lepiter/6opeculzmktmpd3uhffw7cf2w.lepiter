				"code" : "#(#client #queryAndroidLinuxKernel #lookupAndroidBulletinById #queryMavenAndroidLibrary)\n\tcollect: [ :sel |\n\t\tsel -> ([ Gt4SecurityOsvExamples new perform: sel. 'OK' ]\n\t\t\ton: Error do: [ :e | e messageText ]) ]"
			},
