				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "## 5. A reusable client with call history\n\nBuild a single client and make several queries against it — then inspect `client history` to see the request/response pairs. Useful for debugging what OSV returns for unfamiliar packages."
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-04-11T22:40:53.232228-04:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-04-11T22:40:53.232228-04:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "8o/9eHGgS6aVeLWb4Vey/A=="
				},
				"code" : "| client |\nclient := Gt4SecurityOsvClient new.\nclient queryAndroidPackage: 'platform/frameworks/base'.\nclient queryAndroidPackage: 'platform/system/bt'.\nclient queryEcosystem: 'PyPI' package: 'django'.\nclient"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
