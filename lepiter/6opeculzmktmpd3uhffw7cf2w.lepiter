						"dateAndTimeString" : "2026-04-11T22:40:53.21575-04:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "o/VvOENRSp2sj5b5XSauHQ=="
				},
				"code" : "Gt4SecurityOsvClient new\n\tqueryEcosystem: 'Maven'\n\tpackage: 'com.squareup.okhttp3:okhttp'"
