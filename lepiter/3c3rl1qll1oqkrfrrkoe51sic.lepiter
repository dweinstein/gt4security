				"code" : "\"Network remote code exec — same logical vuln, different CVSS versions.\"\n| v2 v31 v4 |\nv2 := Gt4SecurityCvssVector fromString: 'AV:N/AC:L/Au:N/C:C/I:C/A:C'.\nv31 := Gt4SecurityCvssVector fromString: 'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H'.\nv4 := Gt4SecurityCvssVector fromString: 'CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N'.\n{\n\t'V2' -> v2 baseScore -> v2 severityLabel.\n\t'V3.1' -> v31 baseScore -> v31 severityLabel.\n\t'V4.0' -> v4 baseScore -> v4 severityLabel.\n}"
