					"uidString" : "/xo3RjERQfqeOtPnan8GLQ=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "## Data availability by ecosystem\n\nNot all package ecosystems are equally well-covered. Here's what we verified against live APIs:"
			},
			{
				"__type" : "elementSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
