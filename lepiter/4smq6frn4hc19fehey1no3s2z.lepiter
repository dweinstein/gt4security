				"uid" : {
					"__type" : "uid",
					"uidString" : "RnfrGFAnQYG5LtarT7CY0w=="
				},
				"code" : "| view |\rview := GtPhlowColumnedListView new.\rview items: [ {\r  { 'Pushwoosh'. '2022'. 'iOS, Android'. 'Espionage'. 'Russian company masquerading as US-based; push SDK embedded in CDC, US Army apps. Reuters exposé. No CVE issued — privacy/deception concern.' }.\r  { 'Igexin'. '2017'. 'Android'. 'Spyware'. 'Chinese ad SDK downloaded spyware payloads post-install in 500+ Play Store apps. Lookout discovery.' }.\r  { 'Mintegral'. '2020'. 'iOS'. 'Click fraud / data exfil'. 'Chinese ad SDK intercepted ad clicks and URL scheme traffic. Snyk (SourMint) report. Apple took no action.' }.\r  { 'X-Mode / Outlogic'. '2020'. 'iOS, Android'. 'Data harvesting'. 'Location data broker SDK embedded in prayer and weather apps; sold location data to US military contractors. Banned by Apple and Google.' }.\r  { 'OneAudience'. '2019'. 'Android'. 'Data harvesting'. 'SDK harvested Facebook user data beyond authorized scope. Facebook banned it.' }.\r  { 'event-stream (npm)'. '2018'. 'RN / Cordova'. 'Supply chain'. 'Maintainer handed off to attacker who injected a Bitcoin wallet stealer targeting Copay mobile wallet. OSV: 1 entry.' }.\r  { 'ua-parser-js (npm)'. '2021'. 'RN / Cordova'. 'Supply chain'. 'Legitimate npm package (7M weekly downloads) compromised; published versions contained crypto miners and credential stealers.' }.\r  { 'node-ipc (npm)'. '2022'. 'RN / Cordova'. 'Sabotage'. 'Maintainer added destructive code targeting Russian/Belarusian IP addresses (protestware). Wiped files on affected systems.' }.\r  { 'axios (npm)'. '2026'. 'RN / Cordova'. 'Malicious'. 'MAL-2026-2307 — malicious code detected in axios package. Live in OSV.' }.\r  { 'SourMint (Mintegral)'. '2020'. 'iOS'. 'Click fraud'. 'Snyk''s name for the Mintegral SDK incident. Affected 1,200+ iOS apps with 300M+ monthly installs.' }.\r  { 'Tekya / Haken'. '2020'. 'Android'. 'Clicker malware'. 'Malware families hidden in 56 Play Store apps (camera/file utilities). Auto-clicked ads in background. Check Point discovery.' }.\r  { 'Baidu SDK'. '2015-2020'. 'Android'. 'Data exfil'. 'Multiple incidents of Baidu mobile SDKs (Maps, Search, Moplus) leaking IMEI, location, search queries. Trend Micro reports.' }.\r  { 'AirPush'. '2012-2015'. 'Android'. 'Adware'. 'Aggressive ad SDK pushing notifications and injecting bookmarks. Embedded in thousands of free apps.' }\r} ].\rview column: 'Name' text: [ :row | row at: 1 ] weight: 1.2.\rview column: 'Year' text: [ :row | row at: 2 ] weight: 0.5.\rview column: 'Platform' text: [ :row | row at: 3 ] weight: 0.7.\rview column: 'Type' text: [ :row | row at: 4 ] weight: 0.7.\rview column: 'What happened' text: [ :row | row at: 5 ] weight: 3.\rview asElement",
				"elementHeight" : 420,
				"codeHeight" : 50,
				"codeVisible" : false
			},
