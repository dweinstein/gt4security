					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-04-12T09:52:14.293496-04:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-04-12T09:52:14.293496-04:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "PcqNHCF7QYSujESPFut6kw=="
				},
				"code" : "| view |\rview := GtPhlowColumnedListView new.\rview items: [ {\r  { 'OpenSSL'. 'NVD CPE'. 'NVD'. '5+'. '—'. 'TLS in virtually all apps; bundled as native lib' }.\r  { 'SQLite'. 'NVD CPE'. 'NVD'. '5+'. '—'. 'Core to both iOS and Android OS' }.\r  { 'libcurl'. 'NVD CPE'. 'NVD'. '5+'. '—'. 'HTTP client bundled in native code' }.\r  { 'libwebp'. 'NVD CPE'. 'NVD'. '5+'. '—'. 'Image decoding; CVE-2023-4863 was critical zero-click' }.\r  { 'OkHttp'. 'Maven'. 'OSV'. '2'. '0'. 'Default Android HTTP client (Gradle)' }.\r  { 'Retrofit'. 'Maven'. 'OSV'. '2'. '0'. 'Popular Android REST client' }.\r  { 'log4j-core'. 'Maven'. 'OSV'. '9'. '0'. 'Log4Shell (CVE-2021-44228); Android apps using Java logging' }.\r  { 'GSON'. 'Maven'. 'OSV'. '1'. '0'. 'Google JSON parser, bundled in most Android apps' }.\r  { 'axios'. 'npm'. 'OSV'. '12'. '1'. 'HTTP client in React Native / Cordova apps; MAL-2026-2307 is a confirmed malicious entry' }.\r  { 'node-forge'. 'npm'. 'OSV'. '15'. '0'. 'Crypto lib bundled in RN / Cordova apps' }.\r  { 'lodash'. 'npm'. 'OSV'. '10'. '0'. 'Utility lib, ubiquitous in JS-based mobile apps' }.\r  { 'event-stream'. 'npm'. 'OSV'. '1'. '0'. 'Famous 2018 supply chain attack targeting cryptocurrency wallets' }.\r  { 'requests'. 'PyPI'. 'OSV'. '13'. '0'. 'Python HTTP; Kivy / BeeWare mobile apps' }.\r  { 'cryptography'. 'PyPI'. 'OSV'. '28'. '0'. 'Python TLS bindings; bundled in toolchains' }.\r  { 'Pillow'. 'PyPI'. 'OSV'. '113'. '0'. 'Image processing; used by mobile backend pipelines' }.\r  { 'dio'. 'Pub'. 'OSV'. '1'. '0'. 'Flutter HTTP client' }.\r  { 'http'. 'Pub'. 'OSV'. '1'. '0'. 'Dart HTTP client (Flutter)' }.\r  { 'openssl (crate)'. 'crates.io'. 'OSV'. '20'. '0'. 'Rust OpenSSL bindings; Rust-based mobile tools' }\r} ].\rview column: 'Library' text: [ :row | row at: 1 ] weight: 1.4.\rview column: 'Ecosystem' text: [ :row | row at: 2 ] weight: 0.8.\rview column: 'Source' text: [ :row | row at: 3 ] weight: 0.6.\rview column: 'CVEs' text: [ :row | row at: 4 ] weight: 0.4.\rview column: 'MAL' text: [ :row | row at: 5 ] weight: 0.4.\rview column: 'Mobile relevance' text: [ :row | row at: 6 ] weight: 2.\rview asElement",
				"elementHeight" : 450,
				"codeHeight" : 50,
				"codeVisible" : false
			},
