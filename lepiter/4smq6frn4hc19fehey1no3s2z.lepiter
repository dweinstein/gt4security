				"code" : "\"Returns only malicious-package reports (MAL-*). Empty = clean.\"\n{\n\t'axios' -> (Gt4SecurityOsvClient new queryMaliciousEcosystem: 'npm' package: 'axios') size.\n\t'lodash' -> (Gt4SecurityOsvClient new queryMaliciousEcosystem: 'npm' package: 'lodash') size.\n\t'libidn2' -> (Gt4SecurityOsvClient new queryMaliciousEcosystem: 'npm' package: 'libidn2') size.\n}"
			},
