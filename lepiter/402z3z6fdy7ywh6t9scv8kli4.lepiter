					"uidString" : "XAJpgSMrQ/ahbMhoHHvtrw=="
				},
				"code" : "((Gt4SecurityNvdClient new latestIosCvesSince: Date today - 60 days)\n\thighSeverity)\n\tmatching: 'kernel'"
