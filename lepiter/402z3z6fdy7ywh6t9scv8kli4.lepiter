						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-04-12T09:40:02.869644-04:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-04-12T09:40:02.869644-04:00"
